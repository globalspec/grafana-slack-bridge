# grafana-slack-bridge configuration
#
# Copy to /etc/grafana-slack-bridge.env (for systemd) or use as env_file in
# docker-compose. Mode 0600, owned by the service user.
#
# Full reference: docs/configuration.md

# ─── Required ───────────────────────────────────────────────────────────
# Slack bot token (xoxb-...) with scopes:
#   chat:write, chat:write.public, files:write, files:read
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# ─── Channel defaults ──────────────────────────────────────────────────
# Used only when the webhook URL doesn't include ?channel=<id>.
# Prefer using ?channel= on the Grafana contact point URL for multi-channel
# routing (see docs/configuration.md#multi-channel-routing).
SLACK_CHANNEL=alerts-grafana

# Channel ID (Cxxxxx) of the default channel. Setting this avoids a
# conversations.list lookup that requires the channels:read scope.
# Right-click the channel in Slack → View channel details → Channel ID.
#SLACK_CHANNEL_ID=C012345ABCD

# ─── Network ────────────────────────────────────────────────────────────
PORT=8080

# Drop tracked (groupKey → ts) entries idle longer than this.
STATE_TTL_HOURS=24

# ─── Optional: in-bridge image rendering ───────────────────────────────
# If both are set, the bridge will fetch panel screenshots directly from
# Grafana's /render endpoint and upload them as Slack files.
#
# GRAFANA_URL = base URL of your Grafana (e.g. http://grafana:3000 internally)
# GRAFANA_TOKEN = service-account token with Viewer role
#
#GRAFANA_URL=http://grafana:3000
#GRAFANA_TOKEN=glsa_REPLACE_ME
